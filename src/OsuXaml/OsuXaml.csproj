<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OsuXaml</RootNamespace>
    <!-- The system cursor is set through SDL3, whose bindings use pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ppy.osu.Framework" Version="$(OsuFrameworkVersion)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OsuXaml.Tests" />
  </ItemGroup>
</Project>
