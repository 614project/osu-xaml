<CompositeDrawable
    xmlns="osu-xaml"
    xmlns:x="osu-xaml:x"
    xmlns:local="clr-namespace:TodoApp"
    x:Class="TodoApp.MainView"
    x:DataType="local:TodoViewModel"
    RelativeSizeAxes="Both">

  <Box RelativeSizeAxes="Both" Colour="#1e1e2e" />

  <FillFlowContainer Anchor="TopCentre" Origin="TopCentre" Width="560" AutoSizeAxes="Y"
                     Direction="Vertical" Spacing="0,14" Margin="0,48,0,0">

    <SpriteText Text="Todo" Font="Bold,44" Colour="#cdd6f4" />
    <SpriteText Text="{Bind RemainingCount, StringFormat='{0} items left'}" Font="18" Colour="#a6adc8" />

    <FillFlowContainer RelativeSizeAxes="X" AutoSizeAxes="Y" Direction="Horizontal" Spacing="8,0">
      <BasicTextBox x:Name="input" Width="448" Height="40" PlaceholderText="What needs to be done?"
                    Current="{Bind NewText}" OnCommit="{Bind AddItem}" />
      <BasicButton Text="Add" Width="104" Height="40" BackgroundColour="#89b4fa" Action="{Bind AddItem}" />
    </FillFlowContainer>

    <FillFlowContainer x:Name="list" RelativeSizeAxes="X" AutoSizeAxes="Y" Direction="Vertical" Spacing="0,6"
                       ItemsSource="{Bind Items}">
      <FillFlowContainer.ItemTemplate>
        <Container RelativeSizeAxes="X" Height="44" Masking="true" CornerRadius="6">
          <Box RelativeSizeAxes="Both" Colour="#313244" />
          <BasicCheckbox Anchor="CentreLeft" Origin="CentreLeft" X="12" Current="{Bind Done}" />
          <SpriteText Anchor="CentreLeft" Origin="CentreLeft" X="52" Font="20" Colour="#cdd6f4"
                      Text="{Bind Text}" Alpha="{Bind Done, Converter=DoneToAlpha, Animate=250}" />
          <BasicButton Anchor="CentreRight" Origin="CentreRight" X="-8" Size="28" Text="x"
                       BackgroundColour="#f38ba8" Action="{Bind RemoveItem, Source=Root}" />
        </Container>
      </FillFlowContainer.ItemTemplate>
    </FillFlowContainer>

    <BasicButton Text="Clear completed" Width="170" Height="32" BackgroundColour="#45475a"
                 Action="{Bind ClearCompleted}" Alpha="{Bind HasCompleted, Converter=VisibleWhen, Animate=200}" />
  </FillFlowContainer>
</CompositeDrawable>
