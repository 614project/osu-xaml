<Window
    xmlns="osu-xaml"
    xmlns:x="osu-xaml:x"
    xmlns:local="clr-namespace:Gallery"
    x:Class="Gallery.MainWindow"
    x:DataType="local:GalleryViewModel"
    Title="osu!xaml gallery">

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="{Bind NewFile}" />
        <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="{Bind OpenFile}" />
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="{Bind SaveFile}" />
        <Separator />
        <MenuItem Header="_Recent files">
          <MenuItem Header="MainWindow.xaml" Click="{Bind OpenFile}" />
          <MenuItem Header="ListsPage.xaml" Click="{Bind OpenFile}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Word wrap" IsCheckable="True" IsChecked="{Bind WordWrap}" />
        <MenuItem Header="_Status bar" IsCheckable="True" IsChecked="{Bind ShowStatusBar}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="New" Click="{Bind NewFile}" ToolTip="New file (Ctrl+N)" />
        <Button Content="Open" Click="{Bind OpenFile}" ToolTip="Open a file (Ctrl+O)" />
        <Button Content="Save" Click="{Bind SaveFile}" ToolTip="Save (Ctrl+S)" />
        <Separator />
        <ToggleButton Content="Wrap" IsChecked="{Bind WordWrap}" ToolTip="Word wrap, shared with the View menu" />
        <ComboBox ItemsSource="{Bind Themes}" SelectedItem="{Bind SelectedTheme}" Width="150" />
      </ToolBar>
    </ToolBarTray>

    <StatusBar DockPanel.Dock="Bottom" Visibility="{Bind ShowStatusBar, Converter=BoolToVisibility}">
      <StatusBarItem DockPanel.Dock="Right" Content="{Bind Clicks, StringFormat='{0} clicks'}" />
      <Separator DockPanel.Dock="Right" />
      <StatusBarItem DockPanel.Dock="Right" Content="{Bind SelectedTheme}" />
      <StatusBarItem Content="{Bind Status}" />
    </StatusBar>

    <TabControl SelectedIndex="{Bind CurrentTab}">
      <TabItem Header="Layout">
        <local:LayoutPage />
      </TabItem>
      <TabItem Header="Lists">
        <local:ListsPage />
      </TabItem>
      <TabItem Header="Inputs">
        <local:InputsPage />
      </TabItem>
      <TabItem Header="Shapes">
        <local:ShapesPage />
      </TabItem>
      <TabItem Header="Dialogs">
        <local:DialogsPage />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
