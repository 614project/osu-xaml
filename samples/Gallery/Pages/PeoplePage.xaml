<Page
    xmlns="osu-xaml"
    xmlns:x="osu-xaml:x"
    xmlns:local="clr-namespace:Gallery"
    x:Class="Gallery.PeoplePage"
    x:DataType="local:GalleryViewModel"
    Title="People">

  <DockPanel Padding="20">
    <TextBlock DockPanel.Dock="Top" Text="PICK SOMEONE, GO BACK, THEN FORWARD: THE PAGE KEEPS ITS STATE" FontWeight="Bold" Foreground="#a6adc8" FontSize="14" Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Content="Back" Click="OnBack" />
      <TextBlock Text="{Bind Status}" VerticalAlignment="Center" Foreground="#a6adc8" FontSize="14" />
    </StackPanel>
    <ListBox x:Name="people" ItemsSource="{Bind People}" DisplayMemberPath="Name" />
  </DockPanel>
</Page>
