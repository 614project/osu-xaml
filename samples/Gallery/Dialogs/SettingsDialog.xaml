<Dialog
    xmlns="osu-xaml"
    xmlns:x="osu-xaml:x"
    xmlns:local="clr-namespace:Gallery"
    x:Class="Gallery.SettingsDialog"
    x:DataType="local:GalleryViewModel"
    Title="Settings"
    MinWidth="420"
    MaxWidth="460">

  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
      <Label Content="_Name" Target="{Binding ElementName=nameBox}" VerticalAlignment="Center" />
      <TextBox x:Name="nameBox" Grid.Column="1" Text="{Bind Name}" />
      <TextBlock Grid.Row="1" Text="Volume" VerticalAlignment="Center" />
      <Slider Grid.Row="1" Grid.Column="1" Value="{Bind Volume}" Maximum="100" />
    </Grid>
    <CheckBox Content="Enable notifications" IsChecked="{Bind Notifications}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="Save" IsDefault="True" Click="OnSave" />
      <Button Content="Cancel" IsCancel="True" Background="#45475a" Foreground="#cdd6f4" />
    </StackPanel>
  </StackPanel>
</Dialog>
