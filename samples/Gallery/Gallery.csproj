<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gallery</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OsuXaml\OsuXaml.csproj" />
    <ProjectReference Include="..\..\src\OsuXaml.Generator\OsuXaml.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every .xaml file is compiled by the OsuXaml source generator. -->
    <AdditionalFiles Include="**\*.xaml" />
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Writes completion schemas for the XAML to obj/osu-xaml/ after each build. -->
  <Import Project="..\..\src\OsuXaml.Schema\OsuXaml.Schema.targets" />
</Project>
